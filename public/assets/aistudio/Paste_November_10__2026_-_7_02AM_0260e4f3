+package com.example.domain.chat
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.Random
+
+class ChatLogicTest {
+    private val now = 1_800_000_000_000L
+    private val h = 3_600_000L
+    private val d = 24 * h
+
+    private fun draft(kind: ChatKind = ChatKind.TASK, title: String = "Submit record", deadline: Long? = now + 2 * d, all: Boolean = true, rec: Set<String> = emptySet(), body: String = "") =
+        MessageDraft(kind, title, body, ChatPriority.HIGH, deadline, all, rec)
+
+    // ---- roles
+    @Test fun onlyRepsAndOwnersCanSend() {
+        assertFalse(CommunityRole.MEMBER.canSend); assertTrue(CommunityRole.REP.canSend); assertTrue(CommunityRole.OWNER.canSend)
+        assertTrue(CommunityRole.OWNER.canManageMembers); assertFalse(CommunityRole.REP.canManageMembers)
+        assertEquals(CommunityRole.MEMBER, CommunityRole.parse("hacker")); assertEquals(CommunityRole.REP, CommunityRole.parse("rep"))
+        assertEquals(listOf("Only representatives and community owners can send messages."), ChatValidation.validate(draft(), now, CommunityRole.MEMBER))
+    }
+
+    // ---- validation
+    @Test fun validDraftsPass() {
+        assertTrue(ChatValidation.validate(draft(), now, CommunityRole.REP).isEmpty())
+        assertTrue(ChatValidation.validate(draft(kind = ChatKind.MESSAGE, deadline = null), now, CommunityRole.OWNER).isEmpty())
+        assertTrue(ChatValidation.validate(draft(all = false, rec = setOf("u1")), now, CommunityRole.REP).isEmpty())
+    }
+
+    @Test fun invalidDraftsAreRejected() {
+        fun errs(x: MessageDraft) = ChatValidation.validate(x, now, CommunityRole.REP)
+        assertTrue(errs(draft(title = "  ")).contains("Add a title."))
+        assertTrue(errs(draft(title = "x".repeat(101))).any { it.contains("Title") })
+        assertTrue(errs(draft(body = "x".repeat(2001))).any { it.contains("Message") })
+        assertTrue(errs(draft(deadline = null)).contains("A task needs a deadline."))
+        assertTrue(errs(draft(deadline = now + 30_000)).any { it.contains("future") })      // < 1 minute ahead
+        assertTrue(errs(draft(deadline = now - 1)).any { it.contains("future") })
+        assertTrue(errs(draft(kind = ChatKind.MESSAGE, deadline = now + d)).contains("Only tasks have a deadline."))
+        assertTrue(errs(draft(all = false)).any { it.contains("Select at least one") })
+        assertTrue(errs(draft(all = false, rec = (1..301).map { "u$it" }.toSet())).any { it.contains("at most 300") })
+    }
+
+    // ---- deadline state + labels
+    @Test fun deadlineStates() {
+        fun s(dl: Long?, done: Boolean = false, c: Boolean = false) = ChatLogic.deadlineState(dl, done, c, now)
+        assertEquals(DeadlineState.NONE, s(null)); assertEquals(DeadlineState.DONE, s(now + d, done = true))
+        assertEquals(DeadlineState.CANCELLED, s(now + d, c = true)); assertEquals(DeadlineState.OVERDUE, s(now - 1))
+        assertEquals(DeadlineState.DUE_SOON, s(now + d)); assertEquals(DeadlineState.UPCOMING, s(now + d + 1))
+        assertEquals(DeadlineState.DONE, s(now - 5 * h, done = true))   // finished late tasks are simply done
+    }
+
+    @Test fun dueText() {
+        assertEquals("Due in 30 min", ChatLogic.dueText(now + 30 * 60_000L, now)); assertEquals("Due in 5 h", ChatLogic.dueText(now + 5 * h, now))
+        assertEquals("Due in 3 days", ChatLogic.dueText(now + 3 * d + h, now)); assertEquals("Overdue by 2 h", ChatLogic.dueText(now - 2 * h, now))
+        assertEquals("Due in 1 min", ChatLogic.dueText(now + 10_000, now))
+    }
+
+    // ---- reminders
+    @Test fun automaticReminderIsOneDayBefore() {
+        val p = ChatLogic.reminderPlan(now + 3 * d, now, false, false, emptyList())
+        assertEquals(1, p.size); assertEquals(now + 2 * d, p[0].fireAtMillis); assertTrue(p[0].automatic); assertEquals(1440, p[0].leadMinutes)
+    }
+
+    @Test fun customRemindersAreAddedAndSorted() {
+        val p = ChatLogic.reminderPlan(now + 3 * d, now, false, false, listOf(60, 600))
+        assertEquals(listOf(now + 2 * d, now + 3 * d - 600 * 60_000L, now + 3 * d - 60 * 60_000L), p.map { it.fireAtMillis })
+        assertEquals(listOf(true, false, false), p.map { it.automatic })
+    }
+
+    @Test fun noReminderForDoneOrCancelledOrNoDeadline() {
+        assertTrue(ChatLogic.reminderPlan(now + 3 * d, now, true, false, listOf(60)).isEmpty())
+        assertTrue(ChatLogic.reminderPlan(now + 3 * d, now, false, true, listOf(60)).isEmpty())
+        assertTrue(ChatLogic.reminderPlan(null, now, false, false, listOf(60)).isEmpty())
+    }
+
+    @Test fun pastRemindersAreDroppedNotFiredLate() {
+        // Task due in 10 hours: the 1-day reminder is already in the past and is skipped; a 2-hour custom one remains.
+        val p = ChatLogic.reminderPlan(now + 10 * h, now, false, false, listOf(120))
+        assertEquals(listOf(now + 8 * h), p.map { it.fireAtMillis })
+        assertTrue(ChatLogic.reminderPlan(now + h, now, false, false, listOf(120)).isEmpty())
+    }
+
+    @Test fun duplicateMomentsCollapseAndAutoCanBeOff() {
+        val p = ChatLogic.reminderPlan(now + 3 * d, now, false, false, listOf(1440))   // same moment as automatic
+        assertEquals(1, p.size); assertTrue(p[0].automatic)
+        assertEquals(listOf(false), ChatLogic.reminderPlan(now + 3 * d, now, false, false, listOf(60), autoEnabled = false).map { it.automatic })
+    }
+
+    @Test fun customLeadsAreCleaned() {
+        assertEquals(listOf(5, 60, 1440), ChatLogic.cleanCustomLeads(listOf(60, 1, 5, 60, 1440, 99999999)))
+        assertEquals(5, ChatLogic.cleanCustomLeads((1..20).map { it * 10 }).size)
+    }
+
+    // ---- ordering
+    @Test fun taskOrdering() {
+        fun item(id: String, p: ChatPriority = ChatPriority.NORMAL, dl: Long? = now + d, done: Boolean = false, c: Boolean = false, created: Long = 0) =
+            ChatLogic.InboxItem(id, ChatKind.TASK, p, dl, created, done, c)
+        val list = listOf(
+            item("done", done = true), item("cancelled", c = true), item("later-low", ChatPriority.LOW, now + 5 * d),
+            item("soon-normal", dl = now + d), item("urgent-late", ChatPriority.URGENT, now + 9 * d), item("overdue", dl = now - h),
+            item("nodeadline", dl = null)
+        )
+        // priority is compared before deadline: a NORMAL task with no deadline outranks a LOW task due in 5 days
+        assertEquals(listOf("overdue", "urgent-late", "soon-normal", "nodeadline", "later-low", "done", "cancelled"),
+            list.sortedWith(ChatLogic.taskOrder(now)).map { it.id })
+    }
+
+    @Test fun progress() {
+        assertEquals("12 of 30 done (40%)", ChatLogic.progressText(12, 30)); assertEquals("No recipients", ChatLogic.progressText(0, 0))
+        assertEquals("1 of 3 done (33%)", ChatLogic.progressText(1, 3))
+    }
+
+    // ---- join codes
+    @Test fun joinCodes() {
+        val c = JoinCode.generate(Random(42))
+        assertEquals(8, c.length); assertTrue(c.all { it in JoinCode.ALPHABET })
+        assertFalse(c.any { it in "01OIL" })
+        assertEquals("ABCD2345", JoinCode.normalize(" abcd-2345 "))
+        assertNull(JoinCode.normalize("ABCD234")); assertNull(JoinCode.normalize("ABCD2340")); assertNull(JoinCode.normalize("ABCD23456"))
+        assertEquals("ABCD-2345", JoinCode.pretty("ABCD2345"))
+        assertTrue((1..200).map { JoinCode.generate(Random(it.toLong())) }.toSet().size > 190)
+        assertEquals(c, JoinCode.normalize(JoinCode.pretty(c)))
+    }
+}
