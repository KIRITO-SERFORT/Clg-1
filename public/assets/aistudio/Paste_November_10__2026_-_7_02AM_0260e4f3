+// OPTIONAL: instant push notifications for new CHATS messages/tasks.
+// Without this function the app still works: messages appear live while the app is open and are picked up by a
+// background sync (about every 15 minutes) when it is closed. This function makes delivery near-instant.
+//
+// Needs the Firebase Blaze (pay-as-you-go) plan:   cd functions && npm install && firebase deploy --only functions
+// NOT deployed or tested by the author of this file.
+const { onDocumentCreated } = require("firebase-functions/v2/firestore");
+const admin = require("firebase-admin");
+admin.initializeApp();
+
+const DB_ID = process.env.FIRESTORE_DATABASE_ID || "ai-studio-android-clg1-c3e120b1-448b-44b7-96ec-4127b50bcb87";
+
+exports.notifyNewChatMessage = onDocumentCreated(
+  { document: "communities/{cid}/messages/{mid}", database: DB_ID },
+  async (event) => {
+    const m = event.data && event.data.data();
+    if (!m || m.cancelled) return;
+    const { cid, mid } = event.params;
+    const db = admin.firestore(admin.app(), DB_ID);   // same named database the app uses
+
+    // 1. who should be notified
+    let uids;
+    if (m.audience === "selected") uids = m.recipients || [];
+    else {
+      const snap = await db.collection(`communities/${cid}/members`).get();
+      uids = snap.docs.map((d) => d.id);
+    }
+    uids = [...new Set(uids)].filter((u) => u !== m.senderId);
+    if (uids.length === 0) return;
+
+    // 2. their device tokens
+    const tokens = [];
+    for (let i = 0; i < uids.length; i += 20) {
+      const chunk = uids.slice(i, i + 20);
+      const lists = await Promise.all(chunk.map((u) => db.collection(`users/${u}/chat_devices`).get()));
+      lists.forEach((s) => s.docs.forEach((d) => tokens.push(d.id)));
+    }
+    if (tokens.length === 0) return;
+
+    // 3. data-only message: the app builds the notification itself (channel by priority, tap opens the chat)
+    const data = {
+      type: m.kind === "TASK" ? "task" : "message",
+      communityId: cid, messageId: mid, title: String(m.title).slice(0, 100),
+      sender: String(m.senderName || "").slice(0, 60), priority: String(m.priority || "NORMAL"),
+      deadlineMillis: m.deadlineAt ? String(m.deadlineAt.toMillis()) : "",
+    };
+    const priority = m.priority === "URGENT" || m.priority === "HIGH" ? "high" : "normal";
+    for (let i = 0; i < tokens.length; i += 500) {
+      const batch = tokens.slice(i, i + 500);
+      const res = await admin.messaging().sendEachForMulticast({ tokens: batch, data, android: { priority } });
+      // drop tokens that are no longer valid
+      const dead = [];
+      res.responses.forEach((r, idx) => {
+        const code = r.error && r.error.code;
+        if (code === "messaging/registration-token-not-registered" || code === "messaging/invalid-registration-token") dead.push(batch[idx]);
+      });
+      if (dead.length) {
+        const writer = db.bulkWriter();
+        for (const t of dead) for (const u of uids) writer.delete(db.doc(`users/${u}/chat_devices/${t}`)).catch(() => {});
+        await writer.close();
+      }
+    }
+  }
+);
