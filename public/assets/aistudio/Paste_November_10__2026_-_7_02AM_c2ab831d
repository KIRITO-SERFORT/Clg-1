+
+    @Test fun targetRequiredAverage() {
+        // CGPA 8.0 over 60 credits, 20 credits left, target 8.5: (8.5 x 80 - 8 x 60) / 20 = (680 - 480) / 20 = 10 -> needs a 10 (an O) everywhere
