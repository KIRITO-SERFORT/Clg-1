+package com.example.domain.chat
+
+import java.security.SecureRandom
+import java.util.TimeZone
+
+/**
+ * Pure rules for the CHATS section (no Android or Firebase types, so everything here is unit tested on a JVM).
+ * The same rules are enforced again on the server in firestore.rules: the app is never the only gatekeeper.
+ */
+
+enum class ChatKind { MESSAGE, TASK }
+
+enum class ChatPriority(val rank: Int, val label: String) {
+    LOW(0, "Low"), NORMAL(1, "Normal"), HIGH(2, "High"), URGENT(3, "Urgent");
+    companion object { fun parse(s: String?): ChatPriority = values().firstOrNull { it.name == s } ?: NORMAL }
+}
+
+/** MEMBER only reads. REP (class rep, club lead) and OWNER (created the community) can send. Only OWNER manages members. */
+enum class CommunityRole(val canSend: Boolean, val canManageMembers: Boolean) {
+    MEMBER(false, false), REP(true, false), OWNER(true, true);
+    companion object { fun parse(s: String?): CommunityRole = values().firstOrNull { it.name == s?.uppercase() } ?: MEMBER }
+}
+
+enum class CommunityKind(val label: String) { CLASS("Class"), CLUB("Club"), OTHER("Other") }
+
+data class MessageDraft(
+    val kind: ChatKind, val title: String, val body: String, val priority: ChatPriority,
+    val deadlineMillis: Long?, val audienceAll: Boolean, val recipients: Set<String>
+)
+
+object ChatValidation {
+    const val TITLE_MAX = 100
+    const val BODY_MAX = 2000
+    const val MAX_RECIPIENTS = 300
+    const val MIN_DEADLINE_AHEAD_MILLIS = 60_000L
+
+    /** Human-readable problems; empty list = OK to send. */
+    fun validate(d: MessageDraft, nowMillis: Long, senderRole: CommunityRole): List<String> {
+        val e = ArrayList<String>()
+        if (!senderRole.canSend) e += "Only representatives and community owners can send messages."
+        if (d.title.isBlank()) e += "Add a title."
+        if (d.title.trim().length > TITLE_MAX) e += "Title is longer than $TITLE_MAX characters."
+        if (d.body.length > BODY_MAX) e += "Message is longer than $BODY_MAX characters."
+        if (d.kind == ChatKind.TASK) {
+            if (d.deadlineMillis == null) e += "A task needs a deadline."
+            else if (d.deadlineMillis < nowMillis + MIN_DEADLINE_AHEAD_MILLIS) e += "The deadline must be at least a minute in the future."
+        } else if (d.deadlineMillis != null) e += "Only tasks have a deadline."
+        if (!d.audienceAll) {
+            if (d.recipients.isEmpty()) e += "Select at least one member, or send to everyone."
+            if (d.recipients.size > MAX_RECIPIENTS) e += "You can select at most $MAX_RECIPIENTS members."
+        }
+        return e
+    }
+}
+
+enum class DeadlineState { NONE, DONE, CANCELLED, OVERDUE, DUE_SOON, UPCOMING }
+
+data class PlannedReminder(val leadMinutes: Int, val fireAtMillis: Long, val automatic: Boolean)
+
+object ChatLogic {
+    const val AUTO_LEAD_MINUTES = 24 * 60            // "1 day before" for everyone, automatically
+    const val MIN_CUSTOM_LEAD_MINUTES = 5
+    const val MAX_CUSTOM_LEAD_MINUTES = 30 * 24 * 60
+    const val MAX_CUSTOM_REMINDERS = 5
+    private const val MIN = 60_000L
+
+    fun deadlineState(deadlineMillis: Long?, done: Boolean, cancelled: Boolean, now: Long): DeadlineState = when {
+        cancelled -> DeadlineState.CANCELLED
+        deadlineMillis == null -> DeadlineState.NONE
+        done -> DeadlineState.DONE
+        deadlineMillis < now -> DeadlineState.OVERDUE
+        deadlineMillis - now <= AUTO_LEAD_MINUTES * MIN -> DeadlineState.DUE_SOON
+        else -> DeadlineState.UPCOMING
+    }
+
+    /** Text label for badges. Always words (never colour only). */
+    fun dueText(deadlineMillis: Long, now: Long): String {
+        val diffMin = Math.abs(deadlineMillis - now) / MIN
+        val span = when {
+            diffMin < 60 -> "${maxOf(diffMin, 1)} min"
+            diffMin < 48 * 60 -> "${diffMin / 60} h"
+            else -> "${diffMin / (24 * 60)} days"
+        }
+        return if (deadlineMillis < now) "Overdue by $span" else "Due in $span"
+    }
+
+    /** Keeps only sensible custom reminder offsets: 5 min .. 30 days, unique, at most 5. */
+    fun cleanCustomLeads(leads: List<Int>): List<Int> =
+        leads.filter { it in MIN_CUSTOM_LEAD_MINUTES..MAX_CUSTOM_LEAD_MINUTES }.distinct().sorted().take(MAX_CUSTOM_REMINDERS)
+
+    /**
+     * Every reminder that should still fire for a task: the automatic 1-day-before one plus the user's own.
+     * Nothing for done or cancelled tasks, and reminders whose moment has already passed are dropped
+     * (no late, instant notifications). Two reminders at the same moment collapse into one.
+     */
+    fun reminderPlan(
+        deadlineMillis: Long?, now: Long, done: Boolean, cancelled: Boolean,
+        customLeadMinutes: List<Int>, autoEnabled: Boolean = true
+    ): List<PlannedReminder> {
+        if (deadlineMillis == null || done || cancelled) return emptyList()
+        val all = ArrayList<PlannedReminder>()
+        if (autoEnabled) all += PlannedReminder(AUTO_LEAD_MINUTES, deadlineMillis - AUTO_LEAD_MINUTES * MIN, true)
+        cleanCustomLeads(customLeadMinutes).forEach { all += PlannedReminder(it, deadlineMillis - it * MIN, false) }
+        return all.filter { it.fireAtMillis > now }
+            .sortedWith(compareBy({ it.fireAtMillis }, { !it.automatic }))
+            .distinctBy { it.fireAtMillis }
+    }
+
+    data class InboxItem(val id: String, val kind: ChatKind, val priority: ChatPriority, val deadlineMillis: Long?, val createdAtMillis: Long, val done: Boolean, val cancelled: Boolean)
+
+    /** To-do ordering: open before done, overdue first, higher priority first, earlier deadline first, newest last. */
+    fun taskOrder(now: Long): Comparator<InboxItem> = Comparator { a, b ->
+        fun group(i: InboxItem) = when {
+            i.cancelled -> 3
+            i.done -> 2
+            i.deadlineMillis != null && i.deadlineMillis < now -> 0
+            else -> 1
+        }
+        val g = group(a).compareTo(group(b))
+        if (g != 0) return@Comparator g
+        val p = b.priority.rank.compareTo(a.priority.rank)
+        if (p != 0) return@Comparator p
+        val da = a.deadlineMillis ?: Long.MAX_VALUE; val db = b.deadlineMillis ?: Long.MAX_VALUE
+        val d = da.compareTo(db)
+        if (d != 0) return@Comparator d
+        b.createdAtMillis.compareTo(a.createdAtMillis)
+    }
+
+    fun progressText(done: Int, total: Int): String =
+        if (total <= 0) "No recipients" else "$done of $total done (${Math.round(done * 100.0 / total)}%)"
+
+    fun localDayStart(millis: Long, tz: TimeZone): Long {
+        val c = java.util.Calendar.getInstance(tz).apply { timeInMillis = millis }
+        c.set(java.util.Calendar.HOUR_OF_DAY, 0); c.set(java.util.Calendar.MINUTE, 0); c.set(java.util.Calendar.SECOND, 0); c.set(java.util.Calendar.MILLISECOND, 0)
+        return c.timeInMillis
+    }
+}
+
+/** Invite codes: 8 characters from an alphabet without look-alikes (no 0/O, 1/I/L). Generated with SecureRandom. */
+object JoinCode {
+    const val ALPHABET = "ABCDEFGHJKMNPQRSTUVWXYZ23456789"
+    const val LENGTH = 8
+
+    fun generate(random: java.util.Random = SecureRandom()): String =
+        buildString { repeat(LENGTH) { append(ALPHABET[random.nextInt(ALPHABET.length)]) } }
+
+    /** Accepts "abcd-2345", " ABCD 2345 " etc. Returns the canonical code, or null if it cannot be a valid code. */
+    fun normalize(input: String): String? {
+        val s = input.uppercase().filter { it != ' ' && it != '-' }
+        return if (s.length == LENGTH && s.all { it in ALPHABET }) s else null
+    }
+
+    fun pretty(code: String): String = if (code.length == LENGTH) code.substring(0, 4) + "-" + code.substring(4) else code
+}
