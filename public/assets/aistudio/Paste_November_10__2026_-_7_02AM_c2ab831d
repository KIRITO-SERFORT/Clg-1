+class CgpaEvaluatorTest {
+    private fun num(expected: String, actual: BigDecimal?) { assertNotNull(actual); assertEquals("expected $expected got $actual", 0, BigDecimal(expected).compareTo(actual)) }
+    private fun row(id: String, name: String, credits: String, grade: String, counts: Boolean = true) = SubjectRow(id, name, credits, grade, counts)
+
+    private val base = CgpaUiState(semesters = listOf(
+        SemesterBlock("s1", "Sem 1", listOf(row("a", "Maths", "4", "A+"), row("b", "Physics", "3", "A"), row("c", "Chem", "3", "O"))),   // 36 + 24 + 30 = 90 / 10 = 9.00
+        SemesterBlock("s2", "Sem 2", listOf(row("d", "Mech", "4", "B+"), row("e", "Lab", "2", "B")))                                         // 28 + 12 = 40 / 6
+    ))
+
+    @Test fun computesFromTypedRows() {
+        val e = CgpaEvaluator.evaluate(base)
+        num("8.13", e.subjects.cgpa); num("16", e.subjects.totalCredits); assertTrue(e.rowIssues.isEmpty()); assertTrue(e.warnings.isEmpty())
+        num("9", e.subjects.semesters[0].sgpa)
+    }
+
+    @Test fun blankRowsAreIgnoredButBadRowsAreFlaggedNotSilentlyDropped() {
+        val s = base.copy(semesters = listOf(SemesterBlock("s1", "S", listOf(
+            row("ok", "Maths", "4", "A+"), row("blank", "", "", ""), row("nocredit", "X", "", "A"), row("badgrade", "Y", "3", "Z"), row("nograde", "W", "3", ""), row("bigcredit", "V", "99", "A")))))
+        val e = CgpaEvaluator.evaluate(s)
+        num("9", e.subjects.cgpa); num("4", e.subjects.totalCredits)
+        assertEquals(setOf("nocredit", "badgrade", "nograde", "bigcredit"), e.rowIssues.keys)
+        assertEquals("Pick a grade.", e.rowIssues["nograde"]); assertTrue(e.rowIssues["badgrade"]!!.contains("not in your scale"))
+        assertTrue(e.warnings.any { it.contains("4 row(s)") })
+    }
+
+    @Test fun excludedSubjectsDoNotCount() {
+        val s = base.copy(semesters = listOf(SemesterBlock("s", "S", listOf(row("a", "New", "4", "A+"), row("b", "Old attempt", "4", "U", counts = false)))))
+        num("9", CgpaEvaluator.evaluate(s).subjects.cgpa)
+    }
+
+    @Test fun customScaleIsUsed() {
+        val s = base.copy(grades = listOf(GradeRow("1", "Distinction", "10"), GradeRow("2", "Pass", "5"), GradeRow("3", "", "")),
+            semesters = listOf(SemesterBlock("s", "S", listOf(row("a", "x", "2", "distinction"), row("b", "y", "2", "Pass")))))
+        num("7.5", CgpaEvaluator.evaluate(s).subjects.cgpa)                        // (20 + 10) / 4
+        val broken = base.copy(grades = listOf(GradeRow("1", "A", "ten"), GradeRow("2", "B", "8")))
+        assertTrue(CgpaEvaluator.evaluate(broken).warnings.any { it.contains("incomplete") })
+    }
+
+    @Test fun quickModeAndPercentage() {
+        val s = base.copy(mode = 1, factor = "9.5", quick = listOf(QuickRow("1", "S1", "9.0", "24"), QuickRow("2", "S2", "8.5", "22"), QuickRow("3", "S3", "7.9", "20")))
+        val e = CgpaEvaluator.evaluate(s)
+        num("8.5", e.quick.cgpa); num("80.75", e.percent)                           // 8.5 x 9.5
+        assertNull(CgpaEvaluator.evaluate(s.copy(factor = "")).percent)
+        assertTrue(CgpaEvaluator.evaluate(s.copy(factor = "abc")).warnings.any { it.contains("percentage factor") })
+    }
+
+    @Test fun quickModeRejectsSgpaAboveTheScale() {
+        val e = CgpaEvaluator.evaluate(base.copy(mode = 1, quick = listOf(QuickRow("1", "S1", "11", ""), QuickRow("2", "S2", "8", ""))))
+        assertEquals(setOf("1"), e.rowIssues.keys); num("8", e.quick.cgpa)
+    }
+
+    @Test fun targetNeedsAllFourNumbersAndSaneValues() {
+        assertNull(CgpaEvaluator.evaluate(base.copy(target = TargetInputs("8", "60", "", "8.5"))).target)
+        val ok = CgpaEvaluator.evaluate(base.copy(target = TargetInputs("8", "60", "20", "8.25"))).target!!
