+// Security-rules tests for the CHATS feature.
+// Run (needs Node 20+, Java 21 and the Firebase emulator):
+//   npm i --no-save @firebase/rules-unit-testing firebase
+//   npx firebase emulators:exec --only firestore "node --test firestore.chat.test.js"
+// NOTE: these were written but NOT executed in the environment that produced them (no emulator access).
+const { initializeTestEnvironment, assertFails, assertSucceeds } = require("@firebase/rules-unit-testing");
+const { test, before, after, beforeEach } = require("node:test");
+const fs = require("node:fs");
+const firebase = require("firebase/compat/app");
+require("firebase/compat/firestore");
+
+const OWNER = "owner_1", REP = "rep_2", MEMBER = "member_3", OTHER = "other_4", OUTSIDER = "outsider_5";
+const CID = "cse_a", CODE = "ABCD2345";
+const ts = () => firebase.firestore.FieldValue.serverTimestamp();
+const inDays = (n) => new Date(Date.now() + n * 86400000);
+const [host, portStr] = (process.env.FIRESTORE_EMULATOR_HOST || "127.0.0.1:8085").split(":");
+let testEnv;
+
+before(async () => {
+  testEnv = await initializeTestEnvironment({
+    projectId: process.env.GCP_PROJECT || "demo-no-project",
+    firestore: { rules: fs.readFileSync("./firestore.rules", "utf8"), host, port: parseInt(portStr, 10) },
+  });
+});
+after(async () => { if (testEnv) await testEnv.cleanup(); });
+beforeEach(async () => { await testEnv.clearFirestore(); });
+
+const db = (uid) => testEnv.authenticatedContext(uid).firestore();
+
+// Creates community + owner membership + invite code the way the app does (one batch).
+async function createCommunity() {
+  const d = db(OWNER);
+  const b = d.batch();
+  b.set(d.doc(`communities/${CID}`), { name: "CSE A 2026", kind: "CLASS", collegeName: "ACGCET", ownerId: OWNER, createdAt: ts(), verified: false, joinCode: CODE });
+  b.set(d.doc(`communities/${CID}/members/${OWNER}`), { uid: OWNER, displayName: "Olivia", role: "owner", joinedAt: ts() });
+  b.set(d.doc(`joinCodes/${CODE}`), { communityId: CID, name: "CSE A 2026", createdBy: OWNER, createdAt: ts() });
+  await b.commit();
+}
+const join = (uid, code = CODE, role = "member") =>
+  db(uid).doc(`communities/${CID}/members/${uid}`).set({ uid, displayName: "S " + uid, role, joinedAt: ts(), joinCode: code });
+async function seedRoles() {
+  await createCommunity();
+  await assertSucceeds(join(REP)); await assertSucceeds(join(MEMBER)); await assertSucceeds(join(OTHER));
+  await assertSucceeds(db(OWNER).doc(`communities/${CID}/members/${REP}`).update({ role: "rep" }));
+}
+const msg = (uid, over = {}) => ({
+  kind: "TASK", title: "Submit lab record", body: "Hand it to the HOD", priority: "HIGH", deadlineAt: inDays(2),
+  audience: "all", recipients: [], senderId: uid, senderName: "Sender", senderRole: "rep", communityId: CID,
+  createdAt: ts(), updatedAt: ts(), cancelled: false, ...over,
+});
+const send = (uid, id, over) => db(uid).doc(`communities/${CID}/messages/${id}`).set(msg(uid, over));
+
+test("anyone signed in can create a community and becomes its owner", async () => { await assertSucceeds(createCommunity()); });
+test("verified flag cannot be set by clients", async () => {
+  const d = db(OWNER);
+  await assertFails(d.doc(`communities/${CID}`).set({ name: "Fake Official", kind: "CLASS", collegeName: "X", ownerId: OWNER, createdAt: ts(), verified: true, joinCode: CODE }));
+});
+test("cannot create a community owned by someone else", async () => {
+  await assertFails(db(OTHER).doc(`communities/${CID}`).set({ name: "Mine", kind: "CLASS", collegeName: "X", ownerId: OWNER, createdAt: ts(), verified: false, joinCode: CODE }));
+});
+
+test("joining needs a valid invite code and only as a plain member", async () => {
+  await createCommunity();
+  await assertSucceeds(join(MEMBER));
+  await assertFails(join(OTHER, "ZZZZ9999"));                 // wrong code
+  await assertFails(join(OTHER, CODE, "rep"));                // cannot join as rep
+  await assertFails(join(OTHER, CODE, "owner"));              // cannot join as owner
+});
+
+test("a plain member cannot send; reps and owners can", async () => {
+  await seedRoles();
+  await assertFails(send(MEMBER, "m1", { senderRole: "member" }));
+  await assertSucceeds(send(REP, "m2"));
+  await assertSucceeds(send(OWNER, "m3", { senderRole: "owner" }));
+});
+
+test("sender cannot forge identity, role, or a past deadline", async () => {
+  await seedRoles();
+  await assertFails(send(REP, "f1", { senderId: OWNER }));
+  await assertFails(send(REP, "f2", { senderRole: "owner" }));
+  await assertFails(send(REP, "f3", { deadlineAt: inDays(-1) }));
+  await assertFails(send(REP, "f4", { deadlineAt: null }));                       // a TASK needs a deadline
+  await assertFails(send(REP, "f5", { kind: "MESSAGE" }));                        // a MESSAGE has no deadline
+  await assertSucceeds(send(REP, "f6", { kind: "MESSAGE", deadlineAt: null }));
+  await assertFails(send(REP, "f7", { priority: "SUPER" }));
+  await assertFails(send(REP, "f8", { audience: "selected", recipients: [] }));
+  await assertFails(send(REP, "f9", { title: "" }));
+});
+
+test("promotion: only the owner changes roles, nobody promotes themselves", async () => {
+  await seedRoles();
