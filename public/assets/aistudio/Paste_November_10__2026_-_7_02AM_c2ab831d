+        val r = CgpaCalc.requiredAverage(bd("8"), bd("60"), bd("20"), bd("9"), GradeScales.TEN_POINT_U)
+        assertFalse(r.feasible); num("12", r.requiredAverage); num("8.5", r.bestReachableCgpa); assertTrue(r.message.startsWith("Not reachable"))
+    }
+
+    @Test fun targetAlreadySecured() {
