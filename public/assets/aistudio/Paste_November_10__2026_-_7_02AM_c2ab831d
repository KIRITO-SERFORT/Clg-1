+    }
+
+    @Test fun gradeScaleLookups() {
+        num("9", GradeScales.TEN_POINT_U.pointOf("a+")); assertNull(GradeScales.TEN_POINT_U.pointOf("Z")); num("10", GradeScales.TEN_POINT_U.maxPoint); num("4", GradeScales.FOUR_POINT.maxPoint)
