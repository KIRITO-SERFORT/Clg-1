+
+    @Test fun targetNeedsRemainingCredits() {
+        assertFalse(CgpaCalc.requiredAverage(bd("8"), bd("60"), bd("0"), bd("9"), GradeScales.TEN_POINT_U).feasible)
+    }
+
+    @Test fun parsingNumbers() {
+        num("3.5", CgpaCalc.parseNumber("3,5")); num("10", CgpaCalc.parseNumber(" 10 "))
+        assertNull(CgpaCalc.parseNumber("")); assertNull(CgpaCalc.parseNumber("1e3")); assertNull(CgpaCalc.parseNumber("-2")); assertNull(CgpaCalc.parseNumber("1.2.3")); assertNull(CgpaCalc.parseNumber("abc")); assertNull(CgpaCalc.parseNumber("123456789"))
