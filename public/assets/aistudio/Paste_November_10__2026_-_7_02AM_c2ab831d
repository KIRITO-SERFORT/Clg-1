+        assertNull(CgpaCalc.sgpa(emptyList()).sgpa)
+        assertNull(CgpaCalc.cgpaFromSubjects(listOf(CalcSemester("x", listOf(sub("a", "3", "9", counts = false))))).cgpa)
+    }
+
+    @Test fun quickModeWithCredits() {
+        // (9.0 x 24 + 8.5 x 22 + 7.9 x 20) / 66 = (216 + 187 + 158) / 66 = 561 / 66 = 8.5
+        val r = CgpaCalc.cgpaFromSgpa(listOf(QuickSemester("1", bd("9.0"), bd("24")), QuickSemester("2", bd("8.5"), bd("22")), QuickSemester("3", bd("7.9"), bd("20"))), equalWeights = false)
