+package com.example.domain
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.math.BigDecimal
+
+class CgpaCalculatorTest {
+    private fun bd(s: String) = BigDecimal(s)
+    private fun sub(name: String, credits: String, gp: String, counts: Boolean = true) = CalcSubject(name, bd(credits), bd(gp), counts)
+    private fun num(expected: String, actual: BigDecimal?) { assertNotNull(actual); assertEquals("expected $expected got $actual", 0, bd(expected).compareTo(actual)) }
+
+    // Sem 1: (4 x 9) + (3 x 8) + (3 x 10) = 90 over 10 credits -> 9.00.  Sem 2: (4 x 7) + (2 x 6) = 40 over 6 -> 6.666.. -> 6.67
+    private val sem1 = CalcSemester("Sem 1", listOf(sub("Maths", "4", "9"), sub("Physics", "3", "8"), sub("Chemistry", "3", "10")))
+    private val sem2 = CalcSemester("Sem 2", listOf(sub("Mech", "4", "7"), sub("Lab", "2", "6")))
+
+    @Test fun sgpaIsCreditWeighted() {
+        num("9", CgpaCalc.sgpa(sem1.subjects).sgpa); num("6.67", CgpaCalc.sgpa(sem2.subjects).sgpa)
+        num("10", CgpaCalc.sgpa(sem1.subjects).credits)
+    }
+
+    @Test fun cgpaOverAllSubjects() {
+        // (90 + 40) / 16 = 8.125 exactly
+        val r = CgpaCalc.cgpaFromSubjects(listOf(sem1, sem2))
+        num("8.13", r.cgpa); num("16", r.totalCredits); assertEquals(2, r.semesters.size); assertNull(r.note)
+    }
+
+    @Test fun roundingRuleIsAChoice() {
+        val two = listOf(sem1, sem2)
+        num("8.13", CgpaCalc.cgpaFromSubjects(two, rounding = CgpaRounding.HALF_UP).cgpa)
+        num("8.12", CgpaCalc.cgpaFromSubjects(two, rounding = CgpaRounding.HALF_EVEN).cgpa)
