+        val a = CalcSemester("A", listOf(sub("a1", "1", "0"), sub("a2", "1", "0"), sub("a3", "1", "0")))
+        val b = CalcSemester("B", listOf(sub("b1", "1", "1"), sub("b2", "1", "1"), sub("b3", "1", "0")))
+        // exact method: 2 / 6 = 0.3333 -> 0.33
+        num("0.33", CgpaCalc.cgpaFromSubjects(listOf(a, b)).cgpa)
+        // rounded-SGPA-first: (0.00 x 3 + 0.67 x 3) / 6 = 2.01 / 6 = 0.335 -> 0.34 (half up)
+        num("0.34", CgpaCalc.cgpaFromSubjects(listOf(a, b), roundSgpaFirst = true).cgpa)
